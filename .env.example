# Copie para .env e ajuste. O .env não vai para o git.
# Endereço que os computadores da rede usam para abrir o site (troque pelo IP da máquina, ex.: http://192.168.0.20:8080)
SITE_URL=http://localhost:8080
SITE_PORTA=8080
# 127.0.0.1 = só nesta máquina; 0.0.0.0 = qualquer aparelho da rede de casa
SITE_INTERFACE=0.0.0.0

DB_NOME=wordpress
DB_USUARIO=wordpress
DB_SENHA=troque-esta-senha
DB_SENHA_ROOT=troque-esta-tambem

ADMIN_USUARIO=felipe
ADMIN_SENHA=troque-esta-senha-do-painel
ADMIN_EMAIL=comunicacao@ieadcvilaipiranga.com.br

# Testes: congela a data da agenda (o protótipo foi gerado em 2026-10-06). Deixe vazio no uso normal.
IEADC_HOJE=
# 1 = o seed sobrescreve páginas já editadas no painel (cuidado)
IEADC_ATUALIZAR=

# Só para bin/migrar.ps1 (valores do hPanel > Avançado > SSH; nunca coloque a senha aqui).
# Homologação (hospedagem alternativa onde a equipe valida o site; é o ambiente padrão do script):
HOMOLOG_SERVIDOR=
HOMOLOG_PORTA=
HOMOLOG_USUARIO=
HOMOLOG_URL=
# Produção (domínio principal; só com -Ambiente producao):
HOSTINGER_SERVIDOR=
HOSTINGER_PORTA=
HOSTINGER_USUARIO=
# Opcionais: pasta do site no servidor (padrão domains/<endereço>/public_html) e endereço da produção
# (padrão https://ieadcvilaipiranga.com.br):
# HOMOLOG_DESTINO=
# HOSTINGER_DESTINO=
# PRODUCAO_URL=
