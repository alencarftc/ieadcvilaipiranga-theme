# Copie para .env e ajuste. O .env não vai para o git.
# Endereço que os computadores da rede usam para abrir o site (troque pelo IP da máquina, ex.: http://192.168.0.20:8080)
SITE_URL=http://localhost:8080
SITE_PORTA=8080
# 127.0.0.1 = só nesta máquina; 0.0.0.0 = qualquer aparelho da rede de casa
SITE_INTERFACE=0.0.0.0

DB_NOME=wordpress
DB_USUARIO=wordpress
DB_SENHA=troque-esta-senha
DB_SENHA_ROOT=troque-esta-tambem

ADMIN_USUARIO=felipe
ADMIN_SENHA=troque-esta-senha-do-painel
ADMIN_EMAIL=comunicacao@ieadcvilaipiranga.com.br

# Deixe vazio: o site mostra o dia real. Os testes (./bin/testar.sh) fixam 06/10/2026 sozinhos pelo cabeçalho X-Ieadc-Hoje,
# que só vale no ambiente local. Preencha (AAAA-MM-DD) só para ver o site "como se fosse" outro dia, em todos os acessos.
IEADC_HOJE=
# 1 = o seed sobrescreve páginas já editadas no painel (cuidado)
IEADC_ATUALIZAR=

# Só para bin/migrar.ps1 e bin/cadastrar-segredos-github.sh (valores do hPanel > Avançado > SSH; nunca coloque a senha aqui).
# Homologação (onde a equipe valida o site; é o ambiente padrão do script). O destino só é aceito se o par endereço + pasta for
# EXATAMENTE um destes (qualquer outro é recusado antes de conectar; docs/operacao/ci-cd.md):
#   HOMOLOG_URL=https://hml.ieadcvilaipiranga.com.br
#   HOMOLOG_DESTINO=domains/ieadcvilaipiranga.com.br/public_html/hml     (staging da Hostinger: SUBPASTA da produção)
# ou, na transição (hospedagem alternativa): HOMOLOG_URL=https://<algo>.hostingersite.com e HOMOLOG_DESTINO vazio
# (vale domains/<algo>.hostingersite.com/public_html).
HOMOLOG_SERVIDOR=
HOMOLOG_PORTA=
HOMOLOG_USUARIO=
HOMOLOG_URL=
# HOMOLOG_DESTINO=
# Produção (domínio principal; só com -Ambiente producao):
HOSTINGER_SERVIDOR=
HOSTINGER_PORTA=
HOSTINGER_USUARIO=
# Opcionais: pasta do site da produção (só vale domains/ieadcvilaipiranga.com.br/public_html, nunca a subpasta hml) e
# endereço da produção (padrão https://ieadcvilaipiranga.com.br):
# HOSTINGER_DESTINO=
# PRODUCAO_URL=
