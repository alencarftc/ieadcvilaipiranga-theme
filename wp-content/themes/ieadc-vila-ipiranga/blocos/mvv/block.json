				"campo": "rico",
				"rotulo": "Missão"
			}
		},
		"visao": {
			"type": "string",
			"default": "Ser uma igreja unida, relevante e atuante, expandindo o Reino de Deus em todas as regiões geográficas de nosso país.",
			"ieadc": {
				"campo": "rico",
				"rotulo": "Visão"
			}
		},
		"valores": {
			"type": "array",
			"default": [
				{
					"icone": "livro",
					"texto": "Ensino genuíno da Palavra de Deus"
				},
				{
					"icone": "chama",
					"texto": "Fé pentecostal"
				},
				{
					"icone": "megafone",
					"texto": "Evangelização"
				},
				{
					"icone": "degraus",
					"texto": "Discipulado"
				},
				{
					"icone": "casa",
					"texto": "Família"
				},
				{
					"icone": "pessoas",
					"texto": "Comunhão"
				},
				{
					"icone": "maos",
					"texto": "Amor ao próximo"
				}
			],
			"ieadc": {
				"campo": "lista",
				"rotulo": "Valores",
				"itens": {
					"icone": {
						"type": "string",
						"ieadc": {
							"rotulo": "Ícone",
							"campo": "icone"
