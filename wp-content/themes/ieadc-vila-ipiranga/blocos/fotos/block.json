{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ieadc/fotos",
	"title": "Fotos (mosaico)",
	"category": "ieadc",
	"icon": "images-alt2",
	"description": "Grade de fotos em mosaico, com nota embaixo.",
	"supports": {
		"html": false,
		"align": false
	},
	"attributes": {
		"secao": {
			"type": "string",
			"default": "sec",
			"ieadc": {
				"rotulo": "Classes da seção"
			}
		},
		"secaoEstilo": {
			"type": "string",
			"default": "",
			"ieadc": {
				"rotulo": "Estilo da seção"
			}
		},
		"ancora": {
			"type": "string",
			"default": "",
			"ieadc": {
				"rotulo": "Âncora (id)"
			}
		},
		"eyebrow": {
			"type": "string",
			"default": "@ieadc.vilaipiranga",
			"ieadc": {
				"rotulo": "Sobretítulo"
			}
		},
		"titulo": {
			"type": "string",
			"default": "Momentos da nossa igreja",
			"ieadc": {
				"campo": "rico",
				"rotulo": "Título"
			}
		},
		"texto": {
			"type": "string",
			"default": "As fotos vêm do Instagram da igreja.",
			"ieadc": {
				"rotulo": "Texto"
			}
		},
		"botaoTexto": {
			"type": "string",
			"default": "",
			"ieadc": {
				"rotulo": "Texto do botão"
			}
		},
		"botaoLink": {
			"type": "string",
			"default": "",
			"ieadc": {
				"campo": "link",
				"rotulo": "Link do botão"
			}
		},
		"fotos": {
			"type": "array",
			"default": [],
			"ieadc": {
				"campo": "imagens",
				"rotulo": "Fotos"
			}
		},
		"nota": {
			"type": "string",
			"default": "Fotos de crianças e adolescentes seguem a autorização de imagem dos pais ou responsáveis.",
			"ieadc": {
				"rotulo": "Nota"
			}
		}
	},
	"render": "file:./render.php"
}
