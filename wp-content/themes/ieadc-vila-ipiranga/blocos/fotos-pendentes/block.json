{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ieadc/fotos-pendentes",
	"title": "Fotos (aguardando autorização)",
	"category": "ieadc",
	"icon": "shield",
	"description": "Aviso no lugar das fotos enquanto não houver fotos autorizadas.",
	"supports": {
		"html": false,
		"align": false
	},
	"attributes": {
		"secao": {
			"type": "string",
			"default": "sec gelo curva-top",
			"ieadc": {
				"rotulo": "Classes da seção"
			}
		},
		"secaoEstilo": {
			"type": "string",
			"default": "",
			"ieadc": {
				"rotulo": "Estilo da seção"
			}
		},
		"ancora": {
			"type": "string",
			"default": "",
			"ieadc": {
				"rotulo": "Âncora (id)"
			}
		},
		"eyebrow": {
			"type": "string",
			"default": "Galeria",
			"ieadc": {
				"rotulo": "Sobretítulo"
			}
		},
		"titulo": {
			"type": "string",
			"default": "Fotos do ministério",
			"ieadc": {
				"campo": "rico",
				"rotulo": "Título"
			}
		},
		"texto": {
			"type": "string",
			"default": "",
			"ieadc": {
				"rotulo": "Texto"
			}
		},
		"botaoTexto": {
			"type": "string",
			"default": "",
			"ieadc": {
				"rotulo": "Texto do botão"
			}
		},
		"botaoLink": {
			"type": "string",
			"default": "",
			"ieadc": {
				"campo": "link",
				"rotulo": "Link do botão"
			}
		},
		"icone": {
			"type": "string",
			"default": "escudo",
			"ieadc": {
				"campo": "icone",
				"rotulo": "Ícone"
			}
		},
		"aviso": {
			"type": "string",
			"default": "As fotos das crianças só são publicadas com a autorização de imagem dos pais ou responsáveis.",
			"ieadc": {
				"campo": "rico",
				"rotulo": "Texto do aviso"
			}
		}
	},
	"render": "file:./render.php"
}
