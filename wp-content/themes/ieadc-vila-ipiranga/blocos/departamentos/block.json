{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ieadc/departamentos",
	"title": "Departamentos",
	"category": "ieadc",
	"icon": "networking",
	"description": "Líderes de cada departamento (cadastro em Departamentos no painel).",
	"supports": {
		"html": false,
		"align": false
	},
	"attributes": {
		"secao": {
			"type": "string",
			"default": "sec gelo curva-top",
			"ieadc": {
				"rotulo": "Classes da seção"
			}
		},
		"secaoEstilo": {
			"type": "string",
			"default": "",
			"ieadc": {
				"rotulo": "Estilo da seção"
			}
		},
		"ancora": {
			"type": "string",
			"default": "",
			"ieadc": {
				"rotulo": "Âncora (id)"
			}
		},
		"eyebrow": {
			"type": "string",
			"default": "Departamentos",
			"ieadc": {
				"rotulo": "Sobretítulo"
			}
		},
		"titulo": {
			"type": "string",
			"default": "Líderes de cada departamento",
			"ieadc": {
				"campo": "rico",
				"rotulo": "Título"
			}
		},
		"texto": {
			"type": "string",
			"default": "",
			"ieadc": {
				"rotulo": "Texto"
			}
		},
		"botaoTexto": {
			"type": "string",
			"default": "",
			"ieadc": {
				"rotulo": "Texto do botão"
			}
		},
		"botaoLink": {
			"type": "string",
			"default": "",
			"ieadc": {
				"campo": "link",
				"rotulo": "Link do botão"
			}
		},
		"nota": {
			"type": "string",
			"default": "As fotos dos líderes serão publicadas em breve.",
			"ieadc": {
				"rotulo": "Nota"
			}
		}
	},
	"render": "file:./render.php"
}
