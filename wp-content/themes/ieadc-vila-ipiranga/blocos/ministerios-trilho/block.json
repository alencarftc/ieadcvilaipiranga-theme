{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ieadc/ministerios-trilho",
	"title": "Ministérios (trilho)",
	"category": "ieadc",
	"icon": "groups",
	"description": "Cartões com foto de cada ministério (páginas filhas de Ministérios).",
	"supports": {
		"html": false,
		"align": false
	},
	"attributes": {
		"secao": {
			"type": "string",
			"default": "sec",
			"ieadc": {
				"rotulo": "Classes da seção"
			}
		},
		"secaoEstilo": {
			"type": "string",
			"default": "",
			"ieadc": {
				"rotulo": "Estilo da seção"
			}
		},
		"ancora": {
			"type": "string",
			"default": "",
			"ieadc": {
				"rotulo": "Âncora (id)"
			}
		},
		"eyebrow": {
			"type": "string",
			"default": "Ministérios",
			"ieadc": {
				"rotulo": "Sobretítulo"
			}
		},
		"titulo": {
			"type": "string",
			"default": "Encontre o seu <span class=\"azul\">lugar</span>",
			"ieadc": {
				"campo": "rico",
				"rotulo": "Título"
			}
		},
		"texto": {
			"type": "string",
			"default": "Conheça os ministérios da igreja e descubra onde você pode servir.",
			"ieadc": {
				"campo": "texto-longo",
				"rotulo": "Texto"
			}
		},
		"botaoTexto": {
			"type": "string",
			"default": "Ver ministérios",
			"ieadc": {
				"rotulo": "Texto do botão"
			}
		},
		"botaoLink": {
			"type": "string",
			"default": "ministerios",
			"ieadc": {
				"campo": "link",
				"rotulo": "Link do botão"
			}
		}
	},
	"render": "file:./render.php"
}
